{
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git merge * main)",
      "Bash(git merge origin/main)",
      "Bash(git merge upstream/main)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-branch.sh"
          }
        ]
      }
    ]
  }
}